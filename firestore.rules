rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Calls are allowed between people where at least one follows the other.
    function isCallConnection(otherUserId) {
      let other = get(/databases/$(database)/documents/users/$(otherUserId)).data;
      return other.get("followers", []).hasAny([request.auth.uid]) ||
        other.get("following", []).hasAny([request.auth.uid]);
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Fields only the backend (Admin SDK) or an admin may change.
    function keepsPrivilegedUserFields() {
      return request.resource.data.get("role", "user") == resource.data.get("role", "user") &&
        request.resource.data.get("planType", "free") == resource.data.get("planType", "free") &&
        request.resource.data.get("isBanned", false) == resource.data.get("isBanned", false);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // For shared lists (likes, followers, story viewers): the only change allowed is adding or
    // removing yourself, so nobody can edit other people's entries.
    function onlySelfToggled(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return before.difference(after).union(after.difference(before)).hasOnly([request.auth.uid]);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        userId == request.auth.uid &&
        request.resource.data.get("role", "user") == "user" &&
        request.resource.data.get("planType", "free") == "free" &&
        request.resource.data.get("isBanned", false) == false;
      allow update: if signedIn() && (
        (userId == request.auth.uid && keepsPrivilegedUserFields()) ||
        // Following someone updates only their followers list, and only with yourself.
        (changedOnly(["followers", "updatedAt"]) && onlySelfToggled("followers")) ||
        (isAdmin() && changedOnly(["isBanned", "bannedAt", "updatedAt"]))
      );
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        // affectedKeys (not changedKeys) so a viewer can't add new fields to someone's story either.
        (changedOnly(["viewerIds", "updatedAt"]) && onlySelfToggled("viewerIds")) ||
        // Answering a poll sticker: only your own answer (0 or 1) changes.
        (
          changedOnly(["pollVotes"]) &&
          request.resource.data.pollVotes.diff(resource.data.get("pollVotes", {})).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.pollVotes[request.auth.uid] in [0, 1]
        )
      );
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /reels/{reelId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.get("viewCount", 0) == 0 &&
        request.resource.data.get("reachCount", 0) == 0 &&
        !("boostedUntil" in request.resource.data);
      allow update: if signedIn() && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["viewCount", "reachCount", "boostedUntil", "boostPlanId"])
        ) ||
        (changedOnly(["likedBy", "updatedAt"]) && onlySelfToggled("likedBy")) ||
        changedOnly(["repostCount", "updatedAt"]) ||
        (
          // A real view adds exactly one view (and at most one reach) per write.
          changedOnly(["viewCount", "reachCount"]) &&
          request.resource.data.viewCount == resource.data.get("viewCount", 0) + 1 &&
          request.resource.data.get("reachCount", 0) <= resource.data.get("reachCount", 0) + 1 &&
          request.resource.data.get("reachCount", 0) >= resource.data.get("reachCount", 0)
        )
      );
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        (
          // affectedKeys (not changedKeys): others can't add fields such as commentsOff to someone's post.
          changedOnly(["likedBy", "commentCount", "updatedAt"]) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["likedBy"]) || onlySelfToggled("likedBy"))
        )
      );
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /postComments/{commentId} {
      allow read: if signedIn();
      // Not on posts whose creator turned comments off (the creator still can).
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && (
        get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.get("commentsOff", false) != true ||
        get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.userId == request.auth.uid
      );
      allow update: if false;
      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        // A buyer placing an order marks an available listing as pending, nothing else.
        (
          resource.data.userId != request.auth.uid &&
          resource.data.get("listingStatus", "available") == "available" &&
          request.resource.data.listingStatus == "pending" &&
          changedOnly(["listingStatus", "updatedAt"])
        )
      );
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /comments/{commentId} {
      allow read: if signedIn();
      // Not on reels whose creator turned comments off (the creator still can).
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && (
        !("reelId" in request.resource.data) ||
        !exists(/databases/$(database)/documents/reels/$(request.resource.data.reelId)) ||
        get(/databases/$(database)/documents/reels/$(request.resource.data.reelId)).data.get("commentsOff", false) != true ||
        get(/databases/$(database)/documents/reels/$(request.resource.data.reelId)).data.userId == request.auth.uid
      );
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /communities/{communityId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin() ||
        // Joining (public communities only) or leaving: add or remove only yourself.
        (
          changedOnly(["memberIds", "updatedAt"]) &&
          onlySelfToggled("memberIds") &&
          (resource.data.get("visibility", "public") == "public" || !(request.auth.uid in request.resource.data.memberIds))
        )
      );
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /communityPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /savedPosts/{savedPostId} {
      // get: a missing document may be checked (resource == null); list queries must match the condition.
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      // get: a missing document may be checked (resource == null); list queries must match the condition.
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      // Actors may create notifications for other users (likes, comments,
      // follows, mentions, messages) directly from the app when the backend
      // delivery API is unavailable. The actor must identify themselves and
      // cannot notify themselves.
      allow create: if signedIn() &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.userId != request.auth.uid;
      allow update: if signedIn() && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          changedOnly(["readAt"])
        ) || (
          // Deduplicated re-sends by the original actor keep the recipient.
          resource.data.actorId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId
        )
      );
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /devicePushTokens/{tokenId} {
      // get: a missing document may be checked (resource == null); list queries must match the condition.
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // User reports: anyone signed in can file one about content; only admins can read and resolve them.
    match /reports/{reportId} {
      allow create: if signedIn() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == "open";
      allow read, update, delete: if isAdmin();
    }

    // Free voice/video calls: only the two people in the call can see or change it.
    match /calls/{callId} {
      // The phone listens for calls with "calleeId == me", so that condition is allowed on its own too.
      allow read: if signedIn() && (
        resource == null ||
        resource.data.calleeId == request.auth.uid ||
        resource.data.callerId == request.auth.uid ||
        request.auth.uid in resource.data.participantIds
      );
      allow create: if signedIn() &&
        request.resource.data.callerId == request.auth.uid &&
        request.resource.data.participantIds.hasAll([request.resource.data.callerId, request.resource.data.calleeId]) &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.status == "ringing" &&
        isCallConnection(request.resource.data.calleeId);
      allow update: if signedIn() &&
        request.auth.uid in resource.data.participantIds &&
        request.resource.data.callerId == resource.data.callerId &&
        request.resource.data.calleeId == resource.data.calleeId &&
        request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if isAdmin();

      match /{candidateCollection}/{candidateId} {
        allow read, create: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participantIds;
      }
    }

    // Chats and orders: the writer must be one of the people in it. On create the document does not
    // exist yet, so the check reads request.resource (the new data), not resource.
    match /directThreads/{threadId} {
      // get: a missing document may be checked (resource == null); list queries must match the condition.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds.size() == 2;
      allow update: if signedIn() &&
        request.auth.uid in resource.data.participantIds &&
        request.resource.data.participantIds == resource.data.participantIds;
    }

    match /directMessages/{messageId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds;
    }

    match /marketplaceThreads/{threadId} {
      // get: a missing document may be checked (resource == null); list queries must match the condition.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds.size() == 2;
      allow update: if signedIn() &&
        request.auth.uid in resource.data.participantIds &&
        request.resource.data.participantIds == resource.data.participantIds;
    }

    match /marketplaceMessages/{messageId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds;
    }

    match /marketplaceOrders/{orderId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() &&
        request.resource.data.buyerId == request.auth.uid &&
        request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds;
    }

    match /communityChatMessages/{messageId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds;
    }

    // Subscriptions and boosts are written only by the backend after Stripe confirms payment.
    match /subscriptions/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow write: if false;
    }

    match /reelBoosts/{boostId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
